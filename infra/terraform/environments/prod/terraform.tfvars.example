# Copy to terraform.tfvars and adjust. Never put secrets in this file.
aws_region            = "us-east-1"
alert_email           = "team@example.com"
cognito_domain_prefix = "msg-analysis-prod-yourteam" # must be globally unique in the region

callback_urls = ["http://localhost:5173"]
logout_urls   = ["http://localhost:5173"]

coordinator_instance_type = "t3.medium"

worker_nodes = {
  text  = { instance_type = "t3.xlarge", volume_gb = 100 }
  image = { instance_type = "t3.xlarge", volume_gb = 100 }
  audio = { instance_type = "t3.xlarge", volume_gb = 100 } # g4dn.xlarge for GPU (module M5)
}

monthly_budget_usd = 400
