# Terraform working directories and state (state contains secrets!)
**/.terraform/
*.tfstate
*.tfstate.*
crash.log
crash.*.log
*.tfplan
tfplan

# Variable files (keep the examples)
*.tfvars
*.tfvars.json
!*.tfvars.example

# Local overrides
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Keep .terraform.lock.hcl committed
!.terraform.lock.hcl
