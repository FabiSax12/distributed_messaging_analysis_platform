# Environment for the coordinator and workers against compose.dev.yml.
# Local-only values (same defaults as the compose file):
#   set -a; source infra/docker/dev.env; set +a
AMQP_URL=amqp://dev:dev@localhost:5673/
DATABASE_URL=postgresql://dev:dev@localhost:5434/dmap
S3_BUCKET=dmap-dev
S3_ENDPOINT_URL=http://localhost:9100
AWS_ACCESS_KEY_ID=devdevdev
AWS_SECRET_ACCESS_KEY=devdevdev
AWS_REGION=us-east-1
