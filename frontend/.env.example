# Copy to .env.local (git-ignored) and adjust. All values are PUBLIC client
# configuration: never put the origin-verify secret, passwords or tokens here.

# Where the Vite dev server proxies /api (REST + WebSocket):
#   http://localhost:8000                  a local coordinator (uvicorn)
#   https://<distribution>.cloudfront.net  a deployed environment (CloudFront adds X-Origin-Verify)
VITE_PROXY_TARGET=http://localhost:8000

# Buckets proxied under /__s3/<bucket> in development (presigned PUT/GET from localhost).
# AWS bucket hosts only; local MinIO URLs are not rewritten.
VITE_S3_BUCKETS=

# Cognito Hosted UI (terraform output cognito_hosted_ui_domain / cognito_client_id).
# Leave both empty to run against a local coordinator in unauthenticated mode
# (development builds only; a production build without them refuses to start).
VITE_COGNITO_DOMAIN=
VITE_COGNITO_CLIENT_ID=

# Optional overrides; same-origin defaults are right for CloudFront and the Vite proxy.
# VITE_API_BASE=
# VITE_WS_URL=
