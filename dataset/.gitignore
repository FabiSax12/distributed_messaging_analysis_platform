# Extensions are matched case-insensitively ([jJ][pP][gG] = jpg/JPG).
# Raw media is NOT committed: it goes to the dataset bucket (see docs/dataset.md).
# Committed: generators/, schema/, tests/, ground_truth/*.json and, per case,
# manifest.json plus small text chat exports (.txt / result.json).

# Images
*.[jJ][pP][gG]
*.[jJ][pP][eE][gG]
*.[pP][nN][gG]
*.[wW][eE][bB][pP]
*.[gG][iI][fF]
*.[hH][eE][iI][cC]
*.[bB][mM][pP]
*.[tT][iI][fF]
*.[tT][iI][fF][fF]
# Audio / voice notes
*.[oO][gG][gG]
*.[oO][pP][uU][sS]
*.[mM][pP]3
*.[mM]4[aA]
*.[aA][aA][cC]
*.[wW][aA][vV]
*.[fF][lL][aA][cC]
*.[aA][mM][rR]
# Video
*.[mM][pP]4
*.[mM][kK][vV]
*.[mM][oO][vV]
*.[aA][vV][iI]
*.[wW][eE][bB][mM]
*.3[gG][pP]
# Documents and archives (attachments, heavy cases)
*.[pP][dD][fF]
*.[dD][oO][cC]
*.[dD][oO][cC][xX]
*.[xX][lL][sS]
*.[xX][lL][sS][xX]
*.[pP][pP][tT]
*.[pP][pP][tT][xX]
*.[zZ][iI][pP]
*.[tT][aA][rR]
*.[gG][zZ]
*.7[zZ]
*.[rR][aA][rR]
*.[bB][iI][nN]
# Anything large that is not media (e.g. a huge text export) goes in a large/
# folder inside its case; generator scratch output goes in build/.
large/
build/
